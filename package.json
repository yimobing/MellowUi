{
  "name": "melui",
  "version": "1.0.0",
  "description": "MelUi（原名 MellowUI），一款原生 JS 轻量 UI 框架",
  "main": "release/dist/melui.js",
  "files": [
    "release/dist",
    "README.md"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "if exist release rmdir /s /q release",
    "build:js": "rollup -c",
    "build:css": "node build-css.js",
    "build": "npm run clean && npm run build:js && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yimobing/MellowUi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yimobing/MellowUi/issues"
  },
  "homepage": "https://github.com/yimobing/MellowUi#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "cssnano": "^5.0.17",
    "fs-extra": "^9.1.0",
    "postcss": "^8.5.26",
    "rollup": "^2.79.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2"
  }
}
